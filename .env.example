# LinkFox API Configuration
LINKFOX_API_KEY=your_api_key_here
LINKFOX_API_BASE=https://sbappstoreapi.ziniao.com/openapi-router

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/linkfox

# Redis
REDIS_URL=redis://localhost:6379/0

# Task Configuration
MAX_CONCURRENT_TASKS=3
POLL_INTERVAL=5
MAX_RETRIES=3
TASK_TIMEOUT_MINUTES=30

# API Server
HOST=0.0.0.0
PORT=8000
